APP_NAME=PoemBot
APP_ENV=production
APP_TIMEZONE=Asia/Yangon
LOG_LEVEL=INFO
DATA_DIR=./data

# Create a bot with @BotFather, then set the real token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID(s), comma-separated. Only these IDs can manage drafts.
OWNER_IDS=
# Bot must be an administrator with permission to post in this channel.
TARGET_CHANNEL=@your_poetry_channel
TELEGRAM_POLLING_TIMEOUT=30

# Optional; current release runs local rule-based poem classification without an AI key.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=30

# Publishing without approval is intentionally disabled.
APPROVAL_REQUIRED=true
