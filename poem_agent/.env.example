APP_NAME=PoemBot
APP_ENV=development
APP_TIMEZONE=Asia/Yangon
APP_LANGUAGE=my
APP_DEBUG=false
LOG_LEVEL=INFO
DATA_DIR=./data

TELEGRAM_BOT_ENABLED=true
TELEGRAM_USER_CLIENT_ENABLED=false
TELEGRAM_BOT_TOKEN=123456:replace_with_real_token
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=replace_with_real_hash
OWNER_IDS=123456789
TARGET_CHANNEL=@your_poem_channel
TELEGRAM_SESSION_NAME=poembot_session
TELEGRAM_TIMEOUT=30
TELEGRAM_FLOOD_WAIT_LIMIT=60

AI_PROVIDER=openrouter
AI_API_KEY=replace_with_api_key
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=3000
AI_TIMEOUT=60
AI_RETRIES=3

DATABASE_URL=sqlite+aiosqlite:///./data/poembot.db
DATABASE_TIMEOUT=30
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

IMAGE_SOURCES=unsplash,wikimedia
IMAGE_DAILY_LIMIT=5
IMAGE_MAX_FILE_SIZE_MB=15
IMAGE_DOWNLOAD_TIMEOUT=30
IMAGE_CACHE_DAYS=7

SOURCE_CHANNELS=@poetry_source_one,@poetry_source_two
COLLECTOR_SCAN_INTERVAL=15
COLLECTOR_BATCH_SIZE=100
COLLECTOR_HISTORY_LIMIT=5000

DAILY_POST_LIMIT=5
POST_INTERVAL_MINUTES=30
DRAFT_EXPIRY_HOURS=48
APPROVAL_REQUIRED=true
SCHEDULED_POSTS_ENABLED=true

APP_SECRET_KEY=change_me_to_a_secure_random_string_of_at_least_32_chars
CONFIRMATION_TIMEOUT=120
MAX_PENDING_ACTIONS=5
